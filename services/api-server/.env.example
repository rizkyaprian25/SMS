# Salin ke .env lalu isi. Jangan commit .env asli.
# Port 5433 = mapping infra/docker (hindari bentrok postgres proyek lain).
DATABASE_URL="postgresql://sms:sms@localhost:5433/sms?schema=public"

JWT_ACCESS_SECRET="ganti-min-32-karakter-akses"
JWT_REFRESH_SECRET="ganti-min-32-karakter-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Geofence sekolah (isi koordinat nyata saat deploy)
GEOFENCE_LAT="-6.2"
GEOFENCE_LNG="106.8"
GEOFENCE_RADIUS_M="200"
FACE_MIN_SCORE="0.6"

# Jam masuk normal sekolah (WIB, format JJ:MM) — acuan keterlambatan rekap guru
SEKOLAH_JAM_MASUK="07:00"

# Firebase service-account JSON satu baris (untuk push FCM).
# Kosongkan = mode LOG (push tidak dikirim, hanya dicatat di tabel notifikasi).
# FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"...","private_key":"...","client_email":"..."}'

# S3 / MinIO lokal
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-southeast-1"
S3_BUCKET="sms-files"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

PORT="3001"
